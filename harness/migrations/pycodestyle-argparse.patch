+def _option_kinds(parser):
+    """dest -> how to read a config value for each config option.
+
+    optparse exposed this as `o.type or o.action` over
+    `parser.option_list`. The same information lives on the
+    argparse actions, so it is derived rather than stored.
+    """
+    kinds = {}
+    # `config_options` is spelled with hyphens, dests with underscores.
+    wanted = {name.replace('-', '_') for name in parser.config_options}
+    wanted.add('config')
+    for action in parser._actions:
+        if action.dest not in wanted:
+            continue
+        if action.type is int:
+            kinds[action.dest] = 'int'
+        elif action.dest == 'verbose' or action.dest == 'quiet':
+            kinds[action.dest] = 'count'
+        elif isinstance(action, argparse._StoreTrueAction):
+            kinds[action.dest] = 'store_true'
+        elif isinstance(action, argparse._StoreFalseAction):
+            kinds[action.dest] = 'store_false'
+        else:
+            kinds[action.dest] = 'store'
+    return kinds
 
 
